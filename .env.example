# Modal credentials (optional — only needed for cloud GPU engine)
MODAL_TOKEN_ID=ak-xxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxx
MODAL_WORKER_URL=https://your-worker.modal.run

# Hugging Face token (optional — needed to upload community indexes)
HF_TOKEN=hf_xxxxxxxx

# Override default data directory (optional)
NETRYX_DATA_DIR=./netryx_data
